POSTGRES_DB=fxquotes
POSTGRES_USER=fxquotes
POSTGRES_PASSWORD=fxquotes

# Раскомментируйте параметры, если значения приложения по умолчанию не подходят.
# При изменении порта в FX_QUOTES_LISTEN_ADDR настройте также
# FX_QUOTES_CONTAINER_PORT, FX_QUOTES_HOST_PORT и FX_QUOTES_HEALTHCHECK_URL.
# Прямой запуск: 127.0.0.1:8080. Compose явно слушает :8080 внутри контейнера.
# FX_QUOTES_LISTEN_ADDR=:8080
# FX_QUOTES_DATABASE_URL=postgres://fxquotes:fxquotes@postgres:5432/fxquotes?sslmode=disable
# Compose передаёт POSTGRES_USER/PASSWORD/DB отдельно, приложение кодирует URL.
# Пароли с $ в .env заключайте в одинарные кавычки, чтобы избежать подстановки.
# Для запуска без Compose вместо URL можно задать компоненты:
# FX_QUOTES_DATABASE_HOST=127.0.0.1
# FX_QUOTES_DATABASE_PORT=5432
# FX_QUOTES_DATABASE_USER=fxquotes
# FX_QUOTES_DATABASE_PASSWORD=fxquotes
# FX_QUOTES_DATABASE_NAME=fxquotes
# Приложение: disable только для loopback IP, иначе verify-full.
# Compose отключает TLS только для своего сервиса postgres; другой хост — verify-full.
# Вне Compose исключение для доверенной локальной БД задаётся точным именем хоста:
# FX_QUOTES_DATABASE_INSECURE_HOST=postgres
# FX_QUOTES_PROVIDER_URL=https://api.frankfurter.dev
# FX_QUOTES_PROVIDER_TIMEOUT=5s
# FX_QUOTES_HTTP_READ_TIMEOUT=10s
# FX_QUOTES_HTTP_WRITE_TIMEOUT=10s
# FX_QUOTES_REQUEST_TIMEOUT=5s
# FX_QUOTES_WORKER_COUNT=2
# FX_QUOTES_POLL_INTERVAL=500ms
# FX_QUOTES_RECOVERY_INTERVAL=1m
# FX_QUOTES_WORKER_ERROR_DELAY=1s
# FX_QUOTES_LEASE_DURATION=15s
# FX_QUOTES_MAX_ATTEMPTS=3
# FX_QUOTES_MAX_ACTIVE=100
# FX_QUOTES_LOG_LEVEL=info
# FX_QUOTES_SHUTDOWN_TIMEOUT=15s
# FX_QUOTES_HOST_PORT=8080
# FX_QUOTES_CONTAINER_PORT=8080
# FX_QUOTES_HEALTHCHECK_URL=http://127.0.0.1:8080
# По умолчанию Compose ждёт 5m10s: максимум FX_QUOTES_SHUTDOWN_TIMEOUT и
# 10 секунд на отмену обработчиков и закрытие базы. При явной настройке
# задавайте значение больше FX_QUOTES_SHUTDOWN_TIMEOUT на время очистки.
# FX_QUOTES_STOP_GRACE_PERIOD=5m10s

# Самостоятельный нагрузочный стенд: compose.load.yaml, проект fx-quotes-load.
# Он не использует обычные URL БД и провайдера из этого файла.
# FX_QUOTES_LOAD_HOST_PORT=18080
# FX_QUOTES_LOAD_WORKER_COUNT=64
# FX_QUOTES_LOAD_MAX_ACTIVE=100
